# 这是模板文件，会提交到 Git。真实值填在 .env 里（.env 不提交）
# 使用：cp .env.example .env，再把下面的值改成真的

# ── 两把钥匙，必须不同 ───────────────────────────────────────────────
# 1) 对外凭据：调用方发在 X-API-Key 头里的值。发给别人，所以按"会被泄露"设计。
CLIENT_API_KEY=dev-client-key-change-me
# 2) 上游凭据：服务端调 LLM 用。只留在这台机器，绝不外发、绝不回显。
LLM_API_KEY=sk-your-key-here
# 相同会被 config.py 的校验拒绝启动——拆开的意义就在这两把钥匙失效域不同。

LLM_BASE_URL=https://api.deepseek.com/v1
LLM_TIMEOUT=30.0
MAX_CONCURRENT=5
MAX_RETRIES=3
# 流式 token 间隔（毫秒）：调大可肉眼看清"逐字到达"（curl -N 验证用）
STREAM_DELAY_MS=20
